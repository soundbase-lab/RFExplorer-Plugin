{
  "manifestVersion": 1,
  "id": "rf-explorer-wsub1g-plus",
  "name": "RF Explorer WSUB1G+",
  "version": "0.1.3",
  "license": "BUSL-1.1",
  "platforms": ["darwin-arm64"],
  "repository": "https://github.com/soundbase-lab/RFExplorer-Plugin",
  "maintainers": [{ "name": "Matt Dale", "email": "matt.dale@soundbase.app" }],
  "contract": {
    "core": "1.4",
    "modules": { "SpectrumAnalyzer": "1.2" }
  },
  "runtime": { "type": "node", "entrypoint": "main.js" },
  "deployment": ["managed"],
  "template": { "name": "soundbase-plugin-template", "version": "1.0.11" },
  "products": [
    {
      "deviceTypeId": "plugin:rf-explorer-wsub1g-plus/wsub1g-plus",
      "manufacturer": { "id": "rf-explorer", "name": "RF Explorer" },
      "model": {
        "id": "wsub1g-plus",
        "name": "WSUB1G+",
        "displayName": "RF Explorer WSUB1G+"
      },
      "family": { "id": "rf-explorer", "name": "RF Explorer" },
      "capabilities": { "spectrumAnalyzer": true },
      "traits": { "isSpectrumAnalyzer": true }
    }
  ],
  "deviceConfigFields": [
    {
      "id": "serialPath",
      "type": "textinput",
      "label": "Serial port",
      "required": true,
      "manualOnly": true,
      "help": "e.g. /dev/tty.usbserial-1210 or COM5"
    }
  ],
  "stateKeys": []
}
